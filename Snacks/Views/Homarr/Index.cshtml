@model Snacks.Controllers.HomarrIframeModel
@{
    Layout = null;

    string[] units = { "B", "KB", "MB", "GB", "TB", "PB" };
    (string Value, string Unit) FormatBytesParts(long bytes)
    {
        double size = bytes;
        int    unit = 0;
        while (size >= 1024 && unit < units.Length - 1) { size /= 1024; unit++; }
        return (size >= 100 || unit == 0 ? $"{size:0}" : $"{size:0.#}", units[unit]);
    }
    string FormatBytes(long bytes)
    {
        var (v, u) = FormatBytesParts(bytes);
        return $"{v} {u}";
    }
    string FormatCount(int n) =>
        n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M"
        : n >= 10_000  ? $"{n / 1_000.0:0.#}K"
        : n.ToString("N0");
    // Middle truncation: the tail of a media filename (quality tag, extension)
    // is usually the distinguishing part, so never let CSS ellipsis eat it.
    string TruncateMiddle(string s, int max = 46) =>
        string.IsNullOrEmpty(s) || s.Length <= max ? s : s[..(max - 15)] + "…" + s[^14..];
    var (heroValue, heroUnit) = FormatBytesParts(Model.BytesSaved);
    var activeJobs = Model.Workers.SelectMany(n => n.Jobs).Take(2).ToList();

    // ---- sparkline geometry (server-rendered SVG, no scripts) ----
    const double SW = 116, SH = 40;
    var series   = Model.SavingsSeries;
    var showSpark = series.Count >= 2 && series.Any(v => v > 0);
    string sparkLine = "", sparkArea = "";
    double endX = 0, endY = 0;
    if (showSpark)
    {
        var maxV = Math.Max(series.Max(), 1L);
        var pts  = series
            .Select((v, i) => (
                X: i * (SW - 6) / (series.Count - 1) + 3,
                Y: SH - 5 - (double)v / maxV * (SH - 12)))
            .ToList();
        sparkLine = string.Join(" ", pts.Select((p, i) => $"{(i == 0 ? "M" : "L")}{p.X:0.#},{p.Y:0.#}"));
        sparkArea = $"{sparkLine} L{pts[^1].X:0.#},{SH} L{pts[0].X:0.#},{SH} Z";
        (endX, endY) = (pts[^1].X, pts[^1].Y);
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="@Model.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    @if (Model.Refresh > 0)
    {
        <meta http-equiv="refresh" content="@Model.Refresh" />
    }
    <title>Snacks — @Model.InstanceName</title>
    <style>
        :root {
            color-scheme: light;
            --bg-base:  #faf9fc;
            --bg-glow:  rgba(139, 92, 246, 0.07);
            --ink:      #17151d;
            --ink-2:    #4b4856;
            --muted:    #6f6b7d;
            --edge:     rgba(23, 21, 29, 0.09);
            --glass:    rgba(124, 58, 237, 0.045);
            --track:    rgba(23, 21, 29, 0.09);
            --accent:   #7c3aed;
            --accent-2: #a78bfa;
            --accent-ink: #6d28d9;
            --accent-soft: rgba(124, 58, 237, 0.12);
            --glow:     rgba(124, 58, 237, 0.22);
            --good:     #059669;
            --warn:     #b45309;
            --crit:     #dc2626;
            --good-soft: rgba(5, 150, 105, 0.12);
            --warn-soft: rgba(180, 83, 9, 0.12);
            --crit-soft: rgba(220, 38, 38, 0.10);
            --neutral-soft: rgba(23, 21, 29, 0.06);
            --hero-from: #6d28d9;
            --hero-to:   #9061f9;
        }
        [data-theme="dark"] {
            color-scheme: dark;
            --bg-base:  #131217;
            --bg-glow:  rgba(139, 92, 246, 0.16);
            --ink:      #efedf5;
            --ink-2:    #c0bccd;
            --muted:    #8d8a9b;
            --edge:     rgba(255, 255, 255, 0.08);
            --glass:    rgba(255, 255, 255, 0.035);
            --track:    rgba(255, 255, 255, 0.09);
            --accent:   #8b5cf6;
            --accent-2: #c4b5fd;
            --accent-ink: #c4b5fd;
            --accent-soft: rgba(139, 92, 246, 0.18);
            --glow:     rgba(139, 92, 246, 0.45);
            --good:     #34d399;
            --warn:     #fbbf24;
            --crit:     #f87171;
            --good-soft: rgba(52, 211, 153, 0.14);
            --warn-soft: rgba(251, 191, 36, 0.14);
            --crit-soft: rgba(248, 113, 113, 0.13);
            --neutral-soft: rgba(255, 255, 255, 0.07);
            --hero-from: #c4b5fd;
            --hero-to:   #8b5cf6;
        }

        * { box-sizing: border-box; }
        html { background: var(--bg-base); }
        html, body { margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            background: radial-gradient(130% 90% at 18% -10%, var(--bg-glow), transparent 55%) no-repeat var(--bg-base);
            color: var(--ink);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            font-size: 14px; line-height: 1.35;
        }
        .tile { padding: 13px 15px 15px; }

        /* ---- header ---- */
        header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
        .brand {
            flex: none; width: 20px; height: 20px; border-radius: 5px;
            filter: drop-shadow(0 0 8px var(--glow));
        }
        .id       { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .id .name { font-size: 13px; font-weight: 700; letter-spacing: 0.01em; }
        .id .ver  { font-size: 10.5px; color: var(--muted); margin-left: 6px; }
        nav { flex: none; margin-left: auto; display: flex; gap: 3px; }
        nav a {
            font-size: 10.5px; font-weight: 600; color: var(--muted); text-decoration: none;
            padding: 3px 9px; border-radius: 999px; border: 1px solid transparent;
        }
        nav a.active {
            color: var(--accent-ink);
            background: var(--accent-soft);
            border-color: var(--glow);
        }
        nav a:hover:not(.active) { color: var(--ink-2); }
        @@media (max-width: 320px) {
            header   { gap: 6px; }
            .id      { flex: none; }
            .id .ver { display: none; }
            nav      { gap: 1px; }
            nav a    { padding: 3px 5px; font-size: 10px; }
        }

        /* ---- hero + sparkline ---- */
        .hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; margin: 0 1px 12px; }
        .hero .label {
            font-size: 10px; font-weight: 700; letter-spacing: 0.09em;
            text-transform: uppercase; color: var(--muted);
        }
        .hero .value {
            font-size: 38px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05;
            background: linear-gradient(100deg, var(--hero-from), var(--hero-to));
            -webkit-background-clip: text; background-clip: text; color: transparent;
            filter: drop-shadow(0 2px 12px var(--glow));
        }
        .hero .unit { font-size: 18px; font-weight: 700; margin-left: 2px; }
        .hero .sub  { font-size: 11px; color: var(--muted); margin-top: 3px; }
        .spark { flex: none; text-align: right; }
        .spark svg  { display: block; overflow: visible; }
        .spark .cap { font-size: 9.5px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; margin-top: 2px; }
        @@media (max-width: 340px) { .spark { display: none; } }

        /* ---- KPI chips ---- */
        .kpis { display: flex; gap: 8px; flex-wrap: wrap; }
        .kpi {
            flex: 1 1 0; min-width: 88px;
            display: flex; align-items: center; gap: 9px;
            background: var(--glass); border: 1px solid var(--edge); border-radius: 11px;
            padding: 8px 11px;
        }
        .kpi .ic {
            flex: none; width: 26px; height: 26px; border-radius: 8px;
            display: grid; place-items: center; background: var(--neutral-soft); color: var(--muted);
        }
        .kpi .ic svg { width: 14px; height: 14px; }
        .kpi.hot   .ic { background: var(--accent-soft); color: var(--accent-ink); box-shadow: 0 0 9px var(--glow); }
        .kpi.bad   .ic { background: var(--crit-soft);   color: var(--crit); }
        .kpi .v { font-size: 17px; font-weight: 800; line-height: 1.1; }
        .kpi .l { font-size: 10px; color: var(--muted); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }

        /* ---- panels & rows ---- */
        .panel {
            background: var(--glass); border: 1px solid var(--edge); border-radius: 12px;
            padding: 2px 12px; margin-top: 8px;
        }
        .sect {
            font-size: 10px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
            color: var(--muted); margin: 12px 1px 6px;
        }
        .rows    { list-style: none; margin: 0; padding: 0; }
        .rows li {
            display: grid; grid-template-columns: 8px minmax(0, 1fr) auto;
            gap: 3px 9px; align-items: center;
            padding: 8px 0; border-bottom: 1px solid var(--edge);
        }
        .rows li:last-child { border-bottom: 0; }
        .rows .fname { font-size: 12px; font-weight: 500; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rows .right { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
        .rows .right b { color: var(--accent-ink); font-weight: 700; }
        .rows .meter { grid-column: 1 / -1; }
        .rows .jmeta { grid-column: 2 / -1; font-size: 10.5px; color: var(--muted); }

        .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
        .dot.processing { background: var(--accent); box-shadow: 0 0 7px var(--glow); animation: pulse 2s ease-in-out infinite; }
        .dot.good       { background: var(--good); box-shadow: 0 0 6px var(--good-soft); }
        .dot.critical   { background: var(--crit); box-shadow: 0 0 6px var(--crit-soft); }
        @@keyframes pulse { 50% { opacity: 0.4; } }
        @@media (prefers-reduced-motion: reduce) { .dot.processing { animation: none; } }

        .meter { height: 5px; border-radius: 999px; background: var(--track); overflow: hidden; }
        .meter > span {
            display: block; height: 100%; border-radius: 999px;
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
            box-shadow: 0 0 8px var(--glow);
        }

        /* ---- workers ---- */
        .node-h { display: flex; align-items: center; gap: 8px; margin: 12px 1px 6px; }
        .node-h:first-child { margin-top: 2px; }
        .node-h .nname { font-size: 12.5px; font-weight: 700; }
        .node-h .count { margin-left: auto; font-size: 10px; font-weight: 600; color: var(--muted); letter-spacing: 0.05em; text-transform: uppercase; }
        .node-h .count.on { color: var(--accent-ink); }
        .pill {
            font-size: 9.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
            color: var(--warn); background: var(--warn-soft);
            border-radius: 999px; padding: 2px 8px;
        }

        .empty { font-size: 12px; color: var(--muted); text-align: center; padding: 22px 0 16px; }
        .empty svg { display: block; width: 20px; height: 20px; margin: 0 auto 6px; opacity: 0.6; }
    </style>
</head>
<body>
    <div class="tile">
        <header>
            <img class="brand" src="/images/snacks.ico" alt="" aria-hidden="true" />
            <div class="id">
                <span class="name">Snacks</span><span class="ver">@(string.Equals(Model.InstanceName, "Snacks", StringComparison.OrdinalIgnoreCase) ? "" : $"{Model.InstanceName} · ")v@(Model.Version)</span>
            </div>
            <nav>
                <a href="@Model.GetTabHref("stats")"   class="@(Model.Tab == "stats"   ? "active" : "")">Stats</a>
                <a href="@Model.GetTabHref("queue")"   class="@(Model.Tab == "queue"   ? "active" : "")">Queue</a>
                <a href="@Model.GetTabHref("workers")" class="@(Model.Tab == "workers" ? "active" : "")">Workers</a>
            </nav>
        </header>

        @if (Model.Tab == "stats")
        {
            <div class="hero">
                <div>
                    <div class="label">Space saved</div>
                    <div class="value">@heroValue<span class="unit">@heroUnit</span></div>
                    <div class="sub">across @FormatCount(Model.TotalFiles) encodes · @FormatCount(Model.FourKCount) in 4K</div>
                </div>
                @if (showSpark)
                {
                    <div class="spark">
                        <svg width="@SW" height="@SH" viewBox="0 0 @SW @SH" role="img" aria-label="Savings per day, last 14 days">
                            <defs>
                                <linearGradient id="sparkfill" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="var(--accent)" stop-opacity="0.32" />
                                    <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <path d="@sparkArea" fill="url(#sparkfill)" />
                            <path d="@sparkLine" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="@endX.ToString("0.#")" cy="@endY.ToString("0.#")" r="3" fill="var(--accent-2)" stroke="var(--bg-base)" stroke-width="1.5" />
                        </svg>
                        <div class="cap">last 14 days</div>
                    </div>
                }
            </div>

            <div class="kpis">
                <div class="kpi">
                    <div class="ic" aria-hidden="true">
                        <!-- clock -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    </div>
                    <div><div class="v">@FormatCount(Model.Pending)</div><div class="l">Queued</div></div>
                </div>
                <div class="kpi @(Model.Processing > 0 ? "hot" : "")">
                    <div class="ic" aria-hidden="true">
                        <!-- bolt -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                    </div>
                    <div><div class="v">@FormatCount(Model.Processing)</div><div class="l">Processing</div></div>
                </div>
                <div class="kpi @(Model.Failed > 0 ? "bad" : "")">
                    <div class="ic" aria-hidden="true">
                        <!-- alert triangle -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    </div>
                    <div><div class="v">@FormatCount(Model.Failed)</div><div class="l">Failed</div></div>
                </div>
            </div>

            @if (activeJobs.Count > 0)
            {
                <div class="sect">Now encoding</div>
                <div class="panel">
                    <ul class="rows">
                        @foreach (var job in activeJobs)
                        {
                            <li>
                                <span class="dot processing"></span>
                                <span class="fname" title="@job.FileName">@TruncateMiddle(job.FileName)</span>
                                <span class="right"><b>@job.Progress%</b></span>
                                <div class="meter"><span style="width: @job.Progress%;"></span></div>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else if (Model.Tab == "queue")
        {
            if (Model.Queue.Count == 0)
            {
                <div class="empty">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Queue is empty
                </div>
            }
            else
            {
                <div class="panel">
                    <ul class="rows">
                        @foreach (var row in Model.Queue)
                        {
                            var dotClass = row.Status switch
                            {
                                "Processing" => "processing",
                                "Completed"  => "good",
                                "Failed"     => "critical",
                                _            => "",
                            };
                            <li>
                                <span class="dot @dotClass"></span>
                                <span class="fname" title="@row.FileName">@TruncateMiddle(row.FileName)</span>
                                @if (row.Status == "Processing")
                                {
                                    <span class="right"><b>@row.Progress%</b></span>
                                    <div class="meter"><span style="width: @row.Progress%;"></span></div>
                                }
                                else
                                {
                                    <span class="right">@row.Status.ToLowerInvariant() · @FormatBytes(row.SizeBytes)</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            @foreach (var node in Model.Workers)
            {
                <div class="node-h">
                    <span class="dot @(node.Jobs.Count > 0 ? "processing" : "")"></span>
                    <span class="nname">@node.NodeName</span>
                    @if (node.Paused)
                    {
                        <span class="pill">Paused</span>
                    }
                    <span class="count @(node.Jobs.Count > 0 ? "on" : "")">@(node.Jobs.Count == 0 ? "idle" : $"{node.Jobs.Count} active")</span>
                </div>
                @if (node.Jobs.Count > 0)
                {
                    <div class="panel" style="margin-top: 0;">
                        <ul class="rows">
                            @foreach (var job in node.Jobs)
                            {
                                <li>
                                    <span class="dot processing"></span>
                                    <span class="fname" title="@job.FileName">@TruncateMiddle(job.FileName)</span>
                                    <span class="right"><b>@job.Progress%</b></span>
                                    <div class="meter"><span style="width: @job.Progress%;"></span></div>
                                    <div class="jmeta">@job.Device · @job.Phase</div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
    </div>
</body>
</html>
